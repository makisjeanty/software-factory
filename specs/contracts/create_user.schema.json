{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "create_user",
  "description": "Contrato universal (fundamentos/regra 2.2): entradas, saidas e erros esperados.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "email": {"type": "string", "minLength": 3},
        "pwd": {"type": "string", "minLength": 8}
      },
      "required": ["email", "pwd"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["active", "pending"]}
      },
      "required": ["id", "status"]
    },
    "errors": {"type": "array", "items": {"enum": ["InvalidEmail", "WeakPassword"]}}
  }
}
